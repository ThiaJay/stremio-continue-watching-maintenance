{
  "name": "stremio-watch-state-maintenance",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Automatic cross-platform cleanup of stale completed Continue Watching progress in Stremio",
  "scripts": {
    "test": "node --test test/worker.test.js",
    "check": "node scripts/check.mjs",
    "deploy": "wrangler deploy --config wrangler.local.toml",
    "hosted-backups": "node scripts/hosted-backups.mjs",
    "restore": "node scripts/restore.mjs"
  },
  "devDependencies": {
    "wrangler": "4.134.0"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
